# Server-side credentials only. Copy to the repository-root .env (Git ignores it).
# The read-only diagnostic uses these; the frontend does not. No VITE_ prefixes.
MOBULA_API_KEY=
ALCHEMY_API_KEY=

# Populate with the provisioned Robinhood Chain mainnet HTTPS endpoint.
# Recommended provider: Alchemy. Keep its embedded API key server-side.
ROBINHOOD_RPC_URL=

# Separate Robinhood Chain testnet endpoint; mainnet contracts do not carry over.
ROBINHOOD_TESTNET_RPC_URL=

# Plum launch API (backend/). Optional unless noted.
# Long random string used to sign browser sessions. Required.
SESSION_SECRET=
# 4663 (mainnet, default) or 46630 (testnet; then PLUM_FACTORY_ADDRESS and PLUM_ROUTER_ADDRESS are required).
PLUM_CHAIN_ID=
PLUM_FACTORY_ADDRESS=
PLUM_ROUTER_ADDRESS=
# Browser origin allowed to call the API (default http://127.0.0.1:5173) and the public URL used in stored logo links.
PLUM_ORIGIN=
PLUM_PUBLIC_URL=
# Listening port (default 8787), SQLite path, upload directory, confirmation depth (default 12).
PLUM_API_PORT=
PLUM_DB_PATH=
PLUM_UPLOAD_DIR=
PLUM_CONFIRMATIONS=

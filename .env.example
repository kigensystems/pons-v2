# Copy to the repository-root .env (Git ignores it). Only VITE_-prefixed values reach the browser;
# keep every credential unprefixed.
MOBULA_API_KEY=
ALCHEMY_API_KEY=

# Reown AppKit project id for the wallet picker (dashboard.reown.com). Public identifier, not a secret.
VITE_REOWN_PROJECT_ID=

# Populate with the provisioned Robinhood Chain mainnet HTTPS endpoint.
# Recommended provider: Alchemy. Keep its embedded API key server-side.
ROBINHOOD_RPC_URL=

# Separate Robinhood Chain testnet endpoint; mainnet contracts do not carry over.
ROBINHOOD_TESTNET_RPC_URL=

# Plum launch API (backend/). Optional unless noted.
# Long random string used to sign browser sessions. Required.
SESSION_SECRET=
# 4663 (mainnet, default) or 46630 (testnet; then PLUM_FACTORY_ADDRESS and PLUM_ROUTER_ADDRESS are required).
PLUM_CHAIN_ID=
PLUM_FACTORY_ADDRESS=
PLUM_ROUTER_ADDRESS=
# Browser origin allowed to call the API (default http://127.0.0.1:5173) and the public URL used in stored logo links.
PLUM_ORIGIN=
PLUM_PUBLIC_URL=
# Listening host (default 127.0.0.1; a container sets 0.0.0.0) and port (default 8787), SQLite path, upload directory, confirmation depth (default 12).
PLUM_HOST=
PLUM_API_PORT=
PLUM_DB_PATH=
PLUM_UPLOAD_DIR=
PLUM_CONFIRMATIONS=
# Set to 1 behind a reverse proxy so rate limits use X-Forwarded-For.
PLUM_TRUST_PROXY=

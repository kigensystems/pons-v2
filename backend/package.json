{
  "name": "plum-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file=../.env --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src tests",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts"
  },
  "dependencies": {
    "viem": "^2.44.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  }
}
